model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup 'Dimension table'

	annotation PBI_QueryGroupOrder = 0

queryGroup 'Fact table'

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DimCategory","DimCustomer","DimDate","DimEmployee","DimProduct","DimRegion","DimStore","DimSupplier","FactInventory","FactReturns","FactSales"]

annotation PBI_ProTooling = ["DevMode"]

ref table _Measures
ref table DimCategory
ref table DimCustomer
ref table DimDate
ref table DimEmployee
ref table DimProduct
ref table DimRegion
ref table DimStore
ref table DimSupplier
ref table FactInventory
ref table FactReturns
ref table FactSales
ref table 'Top N Parameter'
ref table 'Measure Selector'
ref table 'Dimension Selector'

ref cultureInfo en-US

/// Static Row-Level Security: each regional director sees only their own region.
role 'Region - East'
	modelPermission: read

	tablePermission DimRegion = DimRegion[RegionName] = "East"

role 'Region - West'
	modelPermission: read

	tablePermission DimRegion = DimRegion[RegionName] = "West"

role 'Region - North'
	modelPermission: read

	tablePermission DimRegion = DimRegion[RegionName] = "North"

role 'Region - South'
	modelPermission: read

	tablePermission DimRegion = DimRegion[RegionName] = "South"

